FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b

WORKDIR /app

RUN useradd -u 10001 -m appuser

COPY src/ .

ARG APP_VERSION
ARG GIT_SHA
ARG BUILD_SOURCE=laptop

ENV APP_VERSION=${APP_VERSION} \
    GIT_SHA=${GIT_SHA} \
    BUILD_SOURCE=${BUILD_SOURCE}

USER 10001

EXPOSE 8080

CMD ["python", "app.py"]