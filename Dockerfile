FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928

WORKDIR /app

RUN useradd -u 10001 -m appuser

COPY src/ .

ARG APP_VERSION
ARG GIT_SHA
ARG BUILD_SOURCE=laptop

ENV APP_VERSION=${APP_VERSION} \
    GIT_SHA=${GIT_SHA} \
    BUILD_SOURCE=${BUILD_SOURCE}

USER 10001

EXPOSE 8080

CMD ["python", "app.py"]